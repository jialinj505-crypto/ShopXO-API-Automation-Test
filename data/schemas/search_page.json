{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "商品搜索分页响应结构",
  "type": "object",
  "required": ["code", "data"],
  "properties": {
    "code": {"type": "integer"},
    "data": {
      "type": "object",
      "required": ["total", "page_total", "data"],
      "properties": {
        "total": {"type": ["integer", "string"]},
        "page_total": {"type": ["integer", "string"]},
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "price", "inventory"],
            "properties": {
              "id": {"type": ["string", "integer"]},
              "title": {"type": "string"},
              "price": {"type": ["string", "number"]},
              "inventory": {"type": ["string", "integer"]},
              "is_shelves": {"type": ["string", "integer"]},
              "goods_url": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
