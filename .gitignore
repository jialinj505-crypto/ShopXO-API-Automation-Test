# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---- 测试产物（每次执行都会重新生成，不入库）----
reports/*
!reports/dashboard.html
logs/
allure-results/
allure-report/
*.log

# ---- 覆盖率产物 ----
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---- 类型/格式工具缓存 ----
.mypy_cache/
.ruff_cache/

# ---- IDE / OS ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 本地参考材料（课程讲义、接口文档 PDF 等，不入库）----
*.pdf

# 说明：
# 1. reports/ 下的历史归档、pytest-html、allure 原始结果都是可再生产物，不入库；
# 2. 例外保留 reports/dashboard.html——它是自包含单文件看板，入库后别人 clone 下来
#    就能直接打开看到质量看板效果（页面不含任何账号、token 等敏感信息）；
# 3. 真实项目里请把账号密码放进 CI 凭据（如 GitHub Secrets / Jenkins Credentials），
#    通过 SHOPXO_USER / SHOPXO_PWD 注入，不要写进仓库。
